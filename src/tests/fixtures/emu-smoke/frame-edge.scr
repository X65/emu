# The reference for frame-run.scr: the same split frame, captured by stopping
# inside the vertical blank that follows it, where fb[] holds that frame and
# nothing of the next.  $2210 waits for the raster to wrap after the last line,
# burns about thirteen lines -- past the last line's second DVI copy, far short
# of the next frame -- and parks at $221A.
until 0x2080 2
poke 0xFF34 0x10
poke 0x2200 0xAD 0x10 0xFF 0xC9 0x78 0xD0 0xF9 0x4C 0x07 0x22
poke 0x2210 0xAD 0x10 0xFF 0xD0 0xFB 0xA2 0x00 0xCA 0xD0 0xFD 0x4C 0x1A 0x22
poke 0x2080 0x4C 0x00 0x22
until 0x2207 3
poke 0xFF34 0x20
poke 0x2207 0x4C 0x10 0x22
until 0x221A 2
crc
run 2
crc
exit 0
