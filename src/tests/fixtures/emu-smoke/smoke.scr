until 0x2080 2
peek 0x0300 0xA5
joy none
run 1
peek 0x0301 0xFF
joy up left a
run 1
peek 0x0301 0xDA
joy none
run 1
peek 0x0301 0xFF
# HID gamepads: no device, so the connected flag is clear and nothing is held
peek 0x0302 0x00 0x00 0x00 0x00
# `pad` injects a report; bit 7 is the connected flag the driver sets
pad 1 up a
pad 2 right b
run 1
peek 0x0302 0x81 0x01 0x88 0x02
# releasing one slot hands it back to whatever real device is plugged in
pad 1 off
run 1
peek 0x0302 0x00 0x00 0x88 0x02
pad 2 off
run 1
peek 0x0302 0x00 0x00 0x00 0x00
exit 0
