until 0x2080 2
peek 0x0300 0xA5
joy none
run 1
peek 0x0301 0xFF
joy up left a
run 1
peek 0x0301 0xDA
# All four DE-9 buttons by their platform names: A bit 5, B bit 7, X bit 4,
# Y bit 6 -- not in bit order.
joy a b x y
run 1
peek 0x0301 0x0F
joy c d
run 1
peek 0x0301 0xAF
joy none
run 1
peek 0x0301 0xFF
# The two DE-9 ports are independent and hold at the same time: port 1 up
# (~$01), port 2 down plus button B (~$82).
joy 1 up
joy 2 down b
run 1
peek 0x0301 0xFE
peek 0x0306 0x7D
joy 2 none
run 1
peek 0x0301 0xFE
peek 0x0306 0xFF
joy none
run 1
peek 0x0301 0xFF
# HID gamepads: no device, so the connected flag is clear and nothing is held
peek 0x0302 0x00 0x00 0x00 0x00
# `pad` injects a report; bit 7 is the connected flag the driver sets
pad 1 up a
pad 2 right b
run 1
peek 0x0302 0x81 0x01 0x88 0x02
# releasing one slot hands it back to whatever real device is plugged in
pad 1 off
run 1
peek 0x0302 0x00 0x00 0x88 0x02
pad 2 off
run 1
peek 0x0302 0x00 0x00 0x00 0x00
# The keyboard, across both pages: W is usage id $1A (byte 3, bit 2) and left
# shift is $E1 (byte 28, i.e. page 1 byte 12, bit 1).
key none
run 1
peek 0x0307 0x00 0x00
key w lshift
run 1
peek 0x0307 0x04 0x02
key none
run 1
peek 0x0307 0x00 0x00
exit 0
